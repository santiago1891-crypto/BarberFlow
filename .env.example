# Variables para docker-compose. NO es lo mismo que backend/.env ni
# frontend/.env (esos son para correr cada parte SIN Docker).
#
# Copiá este archivo a ".env" en la raíz del proyecto:
#   cp .env.example .env

# Contraseña del usuario "postgres" dentro del contenedor de la base.
POSTGRES_PASSWORD=cambia-esto

# Usuario admin de BarberFlow.
ADMIN_USERNAME=admin

# Generá el hash así (no hace falta Docker para este paso puntual):
#   cd backend && python generar_hash_admin.py
#
# IMPORTANTE: pegalo ENTRE COMILLAS SIMPLES, tal cual lo imprime el script.
# Un hash bcrypt tiene signos "$" y, sin comillas, Docker Compose los toma
# como variables, "se come" un tramo del hash y el login falla (el backend
# responde 500 y el navegador lo muestra como "no se pudo conectar").
# Ejemplo (el tuyo va a ser distinto):
#   ADMIN_PASSWORD_HASH='$2b$12$abcdefghijklmnopqrstuuABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'
ADMIN_PASSWORD_HASH=''

# Clave larga y aleatoria para firmar los JWT. Por ejemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Dejalo en false salvo que estés adoptando Docker sobre una base que YA
# tenía datos de antes (ver sección "Docker" del README).
SKIP_AUTO_MIGRATE=false

# ---------------------------------------------------------------------------
# Variables de PRODUCCIÓN (compose.prod.yaml). En desarrollo no hacen falta:
# las que siguen solo se usan con `docker compose -f compose.prod.yaml`.
# Ver DEPLOY.md para el alta de un comercio.
# ---------------------------------------------------------------------------

# Dominio público de la instancia. Con "https://" Caddy saca el certificado
# solo (Let's Encrypt). Para un test local: http://localhost
APP_SITE=https://barberia.tudominio.com

# URL pública de la API, SIEMPRE terminada en /api (Caddy le saca ese
# prefijo antes de mandarla al backend). Se incrusta en el JS en tiempo de
# BUILD, así que tiene que ser exacta.
VITE_API_URL=https://barberia.tudominio.com/api

# Con la API bajo /api la app y la API comparten origen: no hace falta.
# Dejalo igual como respaldo, separado por comas.
CORS_ORIGINS=https://barberia.tudominio.com

# Puertos publicados por Caddy (80/443 en producción; 8090/8444 en local).
CADDY_HTTP_PORT=80
CADDY_TLS_PORT=443
