# BarberFlow — Reverse proxy con HTTPS automático (Caddy + Let's Encrypt).
#
# Un solo dominio por comercio: la app y la API comparten origen y la API
# se sirve bajo /api. Caddy le saca el prefijo antes de mandarla al backend,
# así que NO hace falta configurar CORS ni tener dos certificados.
#
# Variable obligatoria (va en el .env de cada instancia):
#   APP_SITE  https://tudominio.com   -> producción (TLS automático)
#             http://localhost        -> test local, sin TLS
#
# Test local:  APP_SITE=http://localhost  CADDY_HTTP_PORT=8090
#              VITE_API_URL=http://localhost:8090/api
#              CORS_ORIGINS=http://localhost:8090
#
# Ver DEPLOY.md para el alta y la baja de un comercio.

{$APP_SITE:https://ejemplo.com} {
	# La API vive bajo /api: Caddy elimina ese prefijo (handle_path) y
	# manda /barberos/... al backend, que no conoce /api.
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# Todo lo demás es el frontend (nginx con el build estático).
	handle {
		reverse_proxy frontend:80
	}
}
