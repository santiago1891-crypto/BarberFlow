# BarberFlow — Frontend (producción)
#
# Build estático de Vite servido por nginx. La URL del backend
# (VITE_API_URL) queda incrustada en el build en tiempo de BUILD, no de
# arranque del contenedor — pasala como build-arg:
#
#   docker build -f Dockerfile.prod --build-arg VITE_API_URL=https://api.tudominio.com -t barberflow-frontend .
#
FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=${VITE_API_URL}

RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
